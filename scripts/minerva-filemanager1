#!/usr/bin/env python3
"""minerva-filemanager1 — «Mostra nella cartella» per i programmi degli altri.

── Perché esiste ──────────────────────────────────────────────────────────────

Giacomo, 6 ottobre 2026: «se da Chrome dopo scaricato un file clicco su apri
cartella invece di aprire il mio file manager si apre quello di KDE». Chrome,
Firefox, VS Code e quasi tutti gli altri per quel gesto non guardano l'app
predefinita delle cartelle: chiamano il servizio D-Bus
`org.freedesktop.FileManager1`, e su questa macchina a dichiararlo era solo
Dolphin (`org.kde.dolphin.FileManager1.service`, `dolphin --daemon`).

Questo è il nostro: parte quando qualcuno lo chiama (attivazione D-Bus, file
in `~/.local/share/dbus-1/services/`, che vince su quelli di sistema), gira la
richiesta a `minerva-files` ed esce dopo un minuto senza chiamate. Non resta in
memoria per niente.

── Fuori da Liquid DE ─────────────────────────────────────────────────────────

Il file di attivazione vale per l'utente, quindi anche in una sessione KDE. Lì
la richiesta va a Dolphin com'era prima (`dolphin --select`), così
installare Liquid DE non cambia il gestore file delle altre scrivanie.
"""

import os
import subprocess
import sys
from urllib.parse import unquote, urlparse

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

NOME = "org.freedesktop.FileManager1"
PERCORSO = "/org/freedesktop/FileManager1"
INTERFACCIA = """
<node>
  <interface name="org.freedesktop.FileManager1">
    <method name="ShowFolders">
      <arg type="as" name="URIs" direction="in"/>
      <arg type="s" name="StartupId" direction="in"/>
    </method>
    <method name="ShowItems">
      <arg type="as" name="URIs" direction="in"/>
      <arg type="s" name="StartupId" direction="in"/>
    </method>
    <method name="ShowItemProperties">
      <arg type="as" name="URIs" direction="in"/>
      <arg type="s" name="StartupId" direction="in"/>
    </method>
  </interface>
</node>
"""

# Dopo quanto senza chiamate si esce. Un minuto: abbastanza per un secondo
# «Mostra nella cartella» subito dopo il primo senza ripartire da capo.
RIPOSO_SECONDI = 60

QUI = os.path.dirname(os.path.realpath(__file__))
MINERVA_FILES = os.path.join(QUI, "minerva-files")


def in_liquid() -> bool:
    """Vero nella sessione di Liquid DE (`XDG_CURRENT_DESKTOP=LiquidDE:Minerva`)."""
    nomi = os.environ.get("XDG_CURRENT_DESKTOP", "").lower().split(":")
    return "liquidde" in nomi or "minerva" in nomi


def percorso(uri: str) -> str:
    """Da `file:///home/tizio/foto%20mare.jpg` a `/home/tizio/foto mare.jpg`.

    Si accettano solo file locali: un indirizzo `http://` non ha una cartella
    da mostrare.
    """
    if uri.startswith("/"):
        return uri
    u = urlparse(uri)
    if u.scheme != "file":
        return ""
    return unquote(u.path)


def lancia(argv) -> None:
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        print(f"minerva-filemanager1: non riesco a lanciare {argv[0]}: {e}", file=sys.stderr)


def mostra(metodo: str, uris) -> None:
    percorsi = [p for p in (percorso(u) for u in uris) if p]
    if not percorsi:
        return
    liquid = in_liquid()
    for p in percorsi:
        if metodo == "ShowFolders":
            lancia([MINERVA_FILES, p] if liquid else ["dolphin", p])
        else:
            # ShowItems e ShowItemProperties: la cartella col file già scelto.
            # Le proprietà si aprono dal gestore file, col tasto destro.
            lancia([MINERVA_FILES, "--mostra", p] if liquid
                   else ["dolphin", "--select", p])


def main() -> int:
    ciclo = GLib.MainLoop()
    nodo = Gio.DBusNodeInfo.new_for_xml(INTERFACCIA)
    scadenza = [0]

    def riarma():
        if scadenza[0]:
            GLib.source_remove(scadenza[0])
        scadenza[0] = GLib.timeout_add_seconds(RIPOSO_SECONDI, lambda: (ciclo.quit(), False)[1])

    def chiamata(_con, _mittente, _percorso, _interfaccia, metodo, parametri, invocazione):
        uris, _avvio = parametri.unpack()
        mostra(metodo, uris)
        invocazione.return_value(None)
        riarma()

    # L'oggetto si registra appena c'è il bus, PRIMA di prendere il nome: la
    # chiamata che ci ha fatto partire arriva appena il nome è nostro, e deve
    # trovare qualcuno.
    def bus_pronto(con, _nome):
        con.register_object(PERCORSO, nodo.interfaces[0], chiamata, None, None)

    def perso(_con, _nome):
        # Il nome ce l'ha già qualcun altro (Dolphin acceso prima di noi):
        # si esce in silenzio invece di restare a guardare.
        ciclo.quit()

    Gio.bus_own_name(Gio.BusType.SESSION, NOME, Gio.BusNameOwnerFlags.NONE,
                     bus_pronto, None, perso)
    riarma()
    ciclo.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
