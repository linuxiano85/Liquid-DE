#!/usr/bin/python3 -I
"""Supervise the two direct children of the pre-login Liquid session.

Installed root-owned by minerva-greetd. Authentication remains in greetd/PAM.
No process groups or unrelated user processes are signalled.
"""
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

# Grace periods are teardown policy, not a normal login delay. Validate on
# physical login before deploying this candidate to the display manager.
GRACE_SECONDS = 3.0
KILL_WAIT_SECONDS = 1.0


def diagnostic(stage):
    # Static labels only: never print PAM data, argv, paths or exceptions.
    print('[LIQUID][GREETER-LIFECYCLE] stage=' + stage, file=sys.stderr,
          flush=True)


def stop_child(child, label):
    if child is None or child.poll() is not None:
        return True
    # This single thread exclusively owns wait/reaping for these Popen objects.
    # An exited, unreaped child keeps its PID; never retain a delayed PID-only
    # watchdog after the child has been reaped.
    child.terminate()
    try:
        child.wait(timeout=GRACE_SECONDS)
        return True
    except subprocess.TimeoutExpired:
        diagnostic(label + '.term-timeout')
    child.kill()
    try:
        child.wait(timeout=KILL_WAIT_SECONDS)
        diagnostic(label + '.killed')
        return True
    except subprocess.TimeoutExpired:
        # SIGKILL cannot make uninterruptible kernel I/O finish. Report this
        # limitation rather than promise an absolute bound or successful reap.
        diagnostic(label + '.unreaped')
        return False


def main():
    dest = os.environ.get('MINERVA_ROOT', '/usr/local/share/minerva')
    state = os.environ.get('MINERVA_CONFIG_DIR', '/var/lib/minerva-greeter')
    logs = Path(os.environ.get('MINERVA_REGISTRI', '/var/log/minerva-greeter'))
    daemon_path = os.environ.get('MINERVA_DEMONE', '/usr/local/lib/minerva/minervad')
    env = dict(os.environ, MINERVA_ROOT=dest, MINERVA_CONFIG_DIR=state,
               MINERVA_SESSIONE='greeter', MINERVA_IPC_SOCKET=state + '/canale.sock',
               XDG_CURRENT_DESKTOP='MinervaWayland:Minerva',
               XDG_CACHE_HOME=state + '/cache', QS_NO_RELOAD_POPUP='1',
               QT_QPA_PLATFORM='wayland')
    env.pop('QT_QUICK_BACKEND', None)
    env.setdefault('LIQUID_TRACE_STARTUP', '1')
    attempt = str(os.getpid()) + '-' + str(time.monotonic_ns())
    env['LIQUID_GREETER_ATTEMPT'] = attempt

    def trace_startup(stage):
        if env['LIQUID_TRACE_STARTUP'] == '1':
            print('[LIQUID][GREETER-STARTUP] component=supervisor '
                  f'attempt={attempt} stage={stage} clock=realtime '
                  f'timestamp_ms={time.time_ns() // 1_000_000}',
                  file=sys.stderr, flush=True)

    trace_startup('supervisor.begin')
    requested_signal = 0

    def request_stop(number, _frame):
        nonlocal requested_signal
        if not requested_signal:
            requested_signal = number

    for number in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(number, request_stop)
    daemon = ui = None
    result = 1
    try:
        # Open both destinations before starting children: a logging failure
        # must not strand a daemon or place its output on the greeter console.
        with (logs / 'demone.log').open('ab', buffering=0) as daemon_log, \
                (logs / 'schermata.log').open('ab', buffering=0) as ui_log:
            if requested_signal:
                return 128 + requested_signal
            daemon = subprocess.Popen([daemon_path], env=env,
                                      stdout=daemon_log, stderr=subprocess.STDOUT)
            trace_startup('daemon.spawned')
            if not requested_signal:
                ui = subprocess.Popen(['qs', '-p', dest + '/minerva-shell/greeter.qml'],
                                      env=env, stdout=ui_log, stderr=subprocess.STDOUT)
                trace_startup('ui.spawned')
            if ui is not None:
                while not requested_signal:
                    try:
                        result = ui.wait(timeout=0.25)
                        break
                    except subprocess.TimeoutExpired:
                        continue
            if requested_signal:
                result = 128 + requested_signal
    except OSError:
        diagnostic('launch-failed')
        result = 1
    finally:
        # Repeated signals only set a flag and cannot interrupt child cleanup.
        ui_clean = stop_child(ui, 'ui')
        daemon_clean = stop_child(daemon, 'daemon')
        if not ui_clean or not daemon_clean:
            result = 1
    return 128 - result if result < 0 else result


if __name__ == '__main__':
    sys.exit(main())
