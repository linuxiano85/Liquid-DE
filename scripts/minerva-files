#!/bin/sh
# minerva-files — Avvia il gestore file di Minerva.
#
# Il gestore file è un programma a sé: un secondo processo `quickshell` che
# esegue `minerva-shell/filemanager.qml`. Non è più una finestra della shell.
# Il perché sta scritto in cima a quel file — in due parole: un errore nel
# gestore file non deve poter spegnere la barra.
#
# Questo script fa tre cose, in ordine: trova dov'è installata Minerva; se il
# gestore file è già aperto gli chiede una scheda in più; altrimenti lo avvia.
set -e

# ── 1. Dov'è Minerva ────────────────────────────────────────────────────────
#
# Non c'è nessun percorso scritto qui dentro. Questo script viene installato in
# ~/.local/bin come COLLEGAMENTO al file vero dentro il progetto: seguendo il
# collegamento si scopre la cartella di Minerva qualunque essa sia, e Minerva
# si può spostare, rinominare o installare da un'altra parte senza toccare una
# riga. È il secondo dei tre problemi strutturali del progetto, e questo ne è
# un pezzo.
SELF=$(readlink -f "$0")
ROOT=$(dirname "$(dirname "$SELF")")
CONFIG="$ROOT/minerva-shell/filemanager.qml"

if [ ! -f "$CONFIG" ]; then
    echo "minerva-files: non trovo $CONFIG" >&2
    exit 1
fi

# ── 2. La cartella da aprire ────────────────────────────────────────────────
#
# Arriva come indirizzo (`file:///home/…`) quando è un altro programma a
# chiamarci, perché è così che il file `.desktop` dichiara di volerlo con `%u`;
# arriva come percorso normale quando lo si scrive a mano in un terminale.
# Vanno accettati tutti e due: chi digita `minerva-files ~/Immagini` ha ragione
# tanto quanto la specifica.
# `--nuova-finestra`: l'azione `new-window` del .desktop, cioè «Apri una
# nuova finestra» della dock. Senza, un gestore file già aperto apre una
# scheda; con, una finestra in più.
NUOVA=""
if [ "${1:-}" = "--nuova-finestra" ]; then
    NUOVA=si
    shift
fi
TARGET=${1:-}
case "$TARGET" in
    file://*)
        TARGET=${TARGET#file://}
        # Gli indirizzi codificano gli spazi e gli accenti in %XX.
        TARGET=$(printf '%b' "$(printf '%s' "$TARGET" | sed 's/%\(..\)/\\x\1/g')")
        ;;
esac

# Serialize cold starts and preload requests. The lock must not be inherited
# by the detached Quickshell process, or subsequent clicks would block forever.
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
[ -d "$RUNTIME" ] && [ "$(stat -c '%u:%a' -- "$RUNTIME")" = "$(id -u):700" ] || {
    echo "minerva-files: directory runtime privata non disponibile" >&2; exit 1;
}
KEY=$(printf '%s' "$CONFIG" | sha256sum | cut -c1-24)
LOCK="$RUNTIME/liquid-files-$(id -u)-$KEY.lock"
exec 9> "$LOCK"
flock -w 12 9 || { echo "minerva-files: un altro avvio non termina" >&2; exit 1; }
SOLO_PREPARA=no
[ "${MINERVA_FILES_DORMIENTE:-0}" = 1 ] && SOLO_PREPARA=si
ipc_files() {
    timeout -k 1 2 qs ipc -p "$CONFIG" call files "$@" 9>&-
}
apri_files() {
    [ "$SOLO_PREPARA" = si ] && return 0
    if [ "${1:-}" = avviato ]; then ipc_files avvia "$TARGET" >/dev/null; return $?; fi
    if [ -n "$NUOVA" ]; then ipc_files finestra "$TARGET" >/dev/null
    else ipc_files open "$TARGET" >/dev/null; fi
}
if ipc_files ping >/dev/null 2>&1; then
    apri_files && exit 0
fi

MINERVA_FILES_PATH="$TARGET"
export MINERVA_FILES_PATH
. "$ROOT/scripts/minerva-ambiente-app"
# A stale user systemd connection must not make the app impossible to launch.
if ! timeout -k 1 10 sh -c ' . "$1"; shift; minerva_avvia_app "$@" ' sh \
        "$ROOT/scripts/minerva-ambiente-app" file qs -d -n -p "$CONFIG" 9>&-; then
    timeout -k 1 10 qs -d -n -p "$CONFIG" 9>&- || exit $?
fi
# -n can report success because another instance is still starting. Always
# deliver an explicit open after readiness, so a preload cannot swallow it.
FINE=$(( $(date +%s) + 10 ))
while [ "$(date +%s)" -lt "$FINE" ]; do
    if ipc_files ping >/dev/null 2>&1; then
        apri_files avviato && exit 0
    fi
    sleep .1
done
echo "minerva-files: il processo non risponde entro il limite; controllare il registro Quickshell. Nessun processo viene terminato automaticamente." >&2
exit 1
